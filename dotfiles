#!/bin/bash
# dotfiles: run one part of the Mac setup, or all of it.
# Usage: ./dotfiles <module> [--dry-run] [--help] [args...]
set -euo pipefail

DOTFILES_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export DOTFILES_ROOT
# shellcheck source=lib/common.sh
. "$DOTFILES_ROOT/lib/common.sh"

DOTFILES_MODULES_DIR="${DOTFILES_MODULES_DIR:-$DOTFILES_ROOT/modules}"
ALL_ORDER="install link iterm editors"   # macos only with --with-macos

# path_setup: make tools installed earlier in this run (or by a previous run)
# visible to every module, even before a new shell picks up ~/.zshrc.
path_setup() {
  [ "${DOTFILES_NO_PATH_SETUP:-0}" = 1 ] && return 0   # tests: keep stubs first
  local d
  for d in "$HOME/.local/bin" "$HOME/.local/share/mise/shims" "$(brew_prefix)/sbin" "$(brew_prefix)/bin"; do
    if [ -d "$d" ]; then
      case ":$PATH:" in *":$d:"*) ;; *) PATH="$d:$PATH" ;; esac
    fi
  done
  export PATH
}

usage() {
  cat <<'EOF'
Usage: ./dotfiles <module> [--dry-run] [--help] [args...]

Modules:
  install   Homebrew + Brewfile, mise tools, oh-my-zsh, Claude Code
  link      Link config files into your home folder (backs up what it replaces)
  macos     Apply macOS settings (dock, hot-corners, keyboard, trackpad, finder, system)
  iterm     Install iTerm2 profiles and settings
  editors   VS Code extensions, Neovim plugins
  update    Update everything, or one part: brew | mise | omz | nvim | tldr
  doctor    Check what's set up and what's missing (changes nothing)
  all       install, link, iterm, editors, then doctor (fresh Mac)
            add --with-macos to also apply the macOS settings
            add --user / --admin to choose the install mode

Options:
  --dry-run   Show what would change without changing anything
  --help      Show help for a module

Docs: README.md and docs/<module>.md
EOF
}

run_module() {
  local name="$1"; shift
  local file="$DOTFILES_MODULES_DIR/$name.sh"
  if [ ! -f "$file" ]; then
    echo "Unknown module: $name (see ./dotfiles --help)" >&2
    exit 2
  fi
  path_setup
  # shellcheck source=/dev/null
  . "$file"
  local args=()
  local a
  for a in "$@"; do
    case "$a" in
      --dry-run) DRY_RUN=1 ;;
      --help|-h) "${name}_help"; return 0 ;;
      *) args+=("$a") ;;
    esac
  done
  export DRY_RUN
  "${name}_main" ${args[@]+"${args[@]}"}
}

main() {
  if [ $# -eq 0 ]; then usage; exit 2; fi
  case "$1" in
    --help|-h|help) usage ;;
    all)
      shift
      local m order="$ALL_ORDER" pass=() install_args=() rc=0 a
      for a in "$@"; do
        case "$a" in
          --with-macos) order="install link macos iterm editors" ;;
          --user)  export DOTFILES_MODE="user";  install_args+=("$a") ;;
          --admin) export DOTFILES_MODE="admin"; install_args+=("$a") ;;
          *) pass+=("$a") ;;
        esac
      done
      for m in $order; do
        log "module: $m"
        if [ "$m" = install ]; then
          ( run_module "$m" ${pass[@]+"${pass[@]}"} ${install_args[@]+"${install_args[@]}"} ) \
            || { warn "module $m failed, continuing with the rest"; rc=1; }
        else
          ( run_module "$m" ${pass[@]+"${pass[@]}"} ) \
            || { warn "module $m failed, continuing with the rest"; rc=1; }
        fi
      done
      log "module: doctor"
      ( run_module doctor ${pass[@]+"${pass[@]}"} ) || rc=1
      print_skips
      exit "$rc"
      ;;
    *) run_module "$@" ;;
  esac
}

main "$@"
