" ~/.ideavimrc: vim keys inside IntelliJ (needs the IdeaVim plugin).
" Docs: https://github.com/JetBrains/ideavim

set relativenumber                       " line numbers relative to the cursor (5j, 3k)
set incsearch hlsearch ignorecase smartcase
let mapleader=","
set clipboard+=unnamed                   " yank/paste uses the macOS clipboard
