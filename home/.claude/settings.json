{
  "permissions": {
    "defaultMode": "auto"
  },
  "skillOverrides": {
    "anthropic-skills:google-workspace": "off",
    "anthropic-skills:morning": "off"
  },
  "hooks": {
    "Notification": [
      {
        "matcher": "permission_prompt|idle_prompt|elicitation_dialog",
        "hooks": [
          {
            "type": "command",
            "command": "afplay -v 0.05 /System/Library/Sounds/Hero.aiff 2>/dev/null || true",
            "async": true
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.config/iterm2/cc-status"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.config/iterm2/cc-status"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.config/iterm2/cc-status"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.config/iterm2/cc-status"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.config/iterm2/cc-status"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.config/iterm2/cc-status"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "afplay -v 0.05 /System/Library/Sounds/Blow.aiff 2>/dev/null || true",
            "async": true
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.config/iterm2/cc-status"
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.config/iterm2/cc-status"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.config/iterm2/cc-status"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.config/iterm2/cc-status"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash $HOME/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "claude-md-management@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "codex@openai-codex": true,
    "commit-commands@claude-plugins-official": true,
    "github@claude-plugins-official": true,
    "hookify@claude-plugins-official": true,
    "mcp-server-dev@claude-plugins-official": false,
    "playwright@claude-plugins-official": true,
    "plugin-dev@claude-plugins-official": false,
    "pr-review-toolkit@claude-plugins-official": false,
    "superpowers@claude-plugins-official": true,
    "mattpocock-skills@claude-plugins-official": true,
    "security-guidance@anthropic-plugin-directory": true,
    "typescript-lsp@claude-plugins-official": true,
    "claude-code-setup@anthropic-plugin-directory": true,
    "remember@claude-plugins-official": true,
    "jdtls-lsp@claude-plugins-official": true,
    "coderabbit@anthropic-plugin-directory": true,
    "image-view@claude-image-view": true,
    "savvy-progress@claude-kit": true,
    "marlon-agentic@marlonbarcarol": true
  },
  "extraKnownMarketplaces": {
    "openai-codex": {
      "source": {
        "source": "github",
        "repo": "openai/codex-plugin-cc"
      }
    },
    "claude-image-view": {
      "source": {
        "source": "github",
        "repo": "jarrodwatts/claude-image-view"
      }
    },
    "claude-kit": {
      "source": {
        "source": "github",
        "repo": "johnnyvizz/claude-kit"
      }
    },
    "marlonbarcarol": {
      "source": {
        "source": "github",
        "repo": "marlonbarcarol/dotfiles"
      }
    }
  },
  "tui": "fullscreen",
  "preferredNotifChannel": "notifications_disabled",
  "switchModelsOnFlag": true,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "pluginConfigs": {
    "savvy-progress@claude-kit": {
      "options": {
        "language": "en",
        "autoOpen": "savvy"
      }
    }
  }
}
